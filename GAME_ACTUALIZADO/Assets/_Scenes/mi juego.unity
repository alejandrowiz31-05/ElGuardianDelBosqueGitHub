  m_Script: {fileID: 11500000, guid: dfca0d22657e5b9468c56d1f604705fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotePickup
  noteText: "<color=#F5DEB3><b><color=#FFD700>El bosque no olvida</color></b></color>,
    y cada hoja guarda un secreto.\nHas despertado en tierras antiguas, donde el
    <color=#00CED1><b>silencio</b></color> es m\xE1s fuerte que las palabras.\nTu
    prop\xF3sito no est\xE1 escrito en piedra, sino en los <b>pasos</b> que decidas
    dar.\nBusca el <color=#32CD32><b>sendero oculto</b></color> bajo las sombras,
    pues all\xED hallar\xE1s la <color=#FF4500><b>verdad del guardi\xE1n</b></color>.\nRecuerda:
    <i>no todo lo que brilla es luz</i>, y <color=#808080>no todo lo que calla est\xE1
    muerto</color>."
  uiPanel: {fileID: 1892715369}
  uiText: {fileID: 516125654}
  interactText: {fileID: 690685079}
